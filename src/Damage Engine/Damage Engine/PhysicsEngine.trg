{
  "Id": 966469041,
  "Comment": null,
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library PhysicsEngine initializer Init\r\n    /* * SISTEMA DE FÍSICAS UNIFICADO (vJASS)\r\n     * Reemplaza: Slide, Knockback, Jump, Vacuum\r\n     * Autor: Arch-Architect (Optimizado para Cofai)\r\n     */\r\n\r\n    globals\r\n        private constant real TIMER_TIMEOUT = 0.03125000 // 32 FPS, estándar de WC3\r\n        private timer MASTER_TIMER = CreateTimer()\r\n        private integer COUNT = 0\r\n        private integer array INDEXES\r\n        private PhysicsInstance array DATA\r\n        \r\n        // Configuración de límites para evitar salir del mapa\r\n        private rect MAP_AREA = null\r\n    endglobals\r\n\r\n    struct PhysicsInstance\r\n        unit target\r\n        real dx\r\n        real dy\r\n        real duration\r\n        real friction // 0.0 a 1.0 (1.0 = sin fricción, 0.9 = frena 10% por tick)\r\n        boolean killDestructables\r\n        string sfx\r\n        \r\n        static method create takes unit u, real angle, real speed, real time, real fric, string effectPath returns thistype\r\n            local thistype this = thistype.allocate()\r\n            set this.target = u\r\n            // Convertimos Polar a Cartesiano una sola vez para ahorrar CPU\r\n            set this.dx = speed * Cos(angle * bj_DEGTORAD)\r\n            set this.dy = speed * Sin(angle * bj_DEGTORAD)\r\n            set this.duration = time\r\n            set this.friction = fric\r\n            set this.killDestructables = false\r\n            set this.sfx = effectPath\r\n            \r\n            // Añadir al stack global\r\n            if COUNT == 0 then\r\n                call TimerStart(MASTER_TIMER, TIMER_TIMEOUT, true, function thistype.onLoop)\r\n            endif\r\n            set DATA[COUNT] = this\r\n            set COUNT = COUNT + 1\r\n            \r\n            return this\r\n        endmethod\r\n\r\n        static method onLoop takes nothing returns nothing\r\n            local integer i = 0\r\n            local thistype this\r\n            local real x\r\n            local real y\r\n            \r\n            loop\r\n                exitwhen i >= COUNT\r\n                set this = DATA[i]\r\n                \r\n                if this.duration > 0 and GetUnitState(this.target, UNIT_STATE_LIFE) > 0.405 then\r\n                    // 1. Mover Unidad\r\n                    set x = GetUnitX(this.target) + this.dx\r\n                    set y = GetUnitY(this.target) + this.dy\r\n                    \r\n                    // Chequeo de límites del mapa (Safety Check)\r\n                    if RectContainsCoords(MAP_AREA, x, y) then\r\n                        call SetUnitX(this.target, x)\r\n                        call SetUnitY(this.target, y)\r\n                    endif\r\n                    \r\n                    // 2. Efecto Especial (Opcional: crear cada X tiempo para no saturar)\r\n                    if this.sfx != \"\" and this.sfx != null then\r\n                         call DestroyEffect(AddSpecialEffect(this.sfx, x, y))\r\n                    endif\r\n                    \r\n                    // 3. Fricción y Tiempo\r\n                    set this.dx = this.dx * this.friction\r\n                    set this.dy = this.dy * this.friction\r\n                    set this.duration = this.duration - TIMER_TIMEOUT\r\n                    \r\n                    set i = i + 1\r\n                else\r\n                    // == LIMPIEZA DE INSTANCIA (Destructor) ==\r\n                    set this.target = null // Importante para evitar Reference Leak\r\n                    call this.destroy()\r\n                    \r\n                    // Algoritmo \"Swap & Pop\" para remover del array eficientemente\r\n                    set COUNT = COUNT - 1\r\n                    set DATA[i] = DATA[COUNT]\r\n                    \r\n                    if COUNT == 0 then\r\n                        call PauseTimer(MASTER_TIMER)\r\n                    endif\r\n                endif\r\n            endloop\r\n        endmethod\r\n    endstruct\r\n\r\n    // == API PÚBLICA (Usa estas funciones en tus detonadores) ==\r\n    \r\n    // Empuje Básico (Knockback)\r\n    public function ApplyKnockback takes unit u, real angle, real distance, real time, string sfx returns nothing\r\n        local real speedPerTick = distance / (time / TIMER_TIMEOUT)\r\n        call PhysicsInstance.create(u, angle, speedPerTick, time, 0.95, sfx)\r\n    endfunction\r\n    \r\n    // Deslizamiento (Slide - Velocidad constante)\r\n    public function ApplySlide takes unit u, real angle, real speed, real time, string sfx returns nothing\r\n        // speed aquí es distancia por tick\r\n        call PhysicsInstance.create(u, angle, speed, time, 1.0, sfx)\r\n    endfunction\r\n\r\n    // Vacuum (Atracción hacia un punto)\r\n    public function ApplyVacuum takes unit target, real centerX, real centerY, real duration returns nothing\r\n        local real angle = Atan2(centerY - GetUnitY(target), centerX - GetUnitX(target)) * bj_RADTODEG\r\n        // Velocidad calculada para llegar al centro aprox\r\n        local real dist = SquareRoot(Pow(centerX - GetUnitX(target), 2) + Pow(centerY - GetUnitY(target), 2))\r\n        local real speed = dist / (duration / TIMER_TIMEOUT)\r\n        \r\n        call PhysicsInstance.create(target, angle, speed, duration, 1.0, \"Abilities\\\\Spells\\\\Human\\\\FlakCannons\\\\FlakTarget.mdl\")\r\n    endfunction\r\n\r\n    private function Init takes nothing returns nothing\r\n        set MAP_AREA = GetPlayableMapRect()\r\n    endfunction\r\nendlibrary",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}