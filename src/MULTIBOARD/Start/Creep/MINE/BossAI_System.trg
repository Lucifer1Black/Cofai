{
  "Id": 1531503578,
  "Comment": null,
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library BossAISystem initializer Init requires PhysicsEngine, AMUpdateConfig\r\n\r\n    globals\r\n        // === CONFIGURACIÓN DE COMBATE ===\r\n        private constant real CHECK_INTERVAL = 1.00  // Frecuencia de la IA (segundos)\r\n        \r\n        // KIL'JAEDEN (FUEGO - RANGO)\r\n        private constant real KJ_SPELL_COOLDOWN = 8.00\r\n        private constant real KJ_AOE_RANGE = 600.00\r\n        private constant real KJ_PUSH_DIST = 400.00\r\n        private constant string KJ_EFFECT = \"Abilities\\\\Spells\\\\Other\\\\Doom\\\\DoomDeath.mdl\"\r\n        \r\n        // ARTHAS (HIELO - MELEE)\r\n        private constant real LK_SPELL_COOLDOWN = 10.00\r\n        private constant real LK_PULL_RANGE = 700.00\r\n        private constant string LK_EFFECT = \"Abilities\\\\Spells\\\\Undead\\\\FrostNova\\\\FrostNovaTarget.mdl\"\r\n        \r\n        // Variables Internas\r\n        private timer AiTimer = CreateTimer()\r\n        private real CooldownKJ = 0.00\r\n        private real CooldownLK = 0.00\r\n        private group TempGroup = CreateGroup()\r\n    endglobals\r\n\r\n    // ================================================================\r\n    // HABILIDAD 1: KIL'JAEDEN - INFERNAL REPULSION (EMPUJE)\r\n    // ================================================================\r\n    private function Kiljaeden_Logic takes nothing returns nothing\r\n        local unit boss = udg_Game_Boss_Kiljaeden\r\n        local unit target\r\n        local real x\r\n        local real y\r\n        local real angle\r\n        \r\n        // 1. Validar que el boss exista y esté vivo\r\n        if boss == null or GetUnitState(boss, UNIT_STATE_LIFE) <= 0.405 then\r\n            return\r\n        endif\r\n        \r\n        set x = GetUnitX(boss)\r\n        set y = GetUnitY(boss)\r\n        \r\n        // 2. Reducir Cooldown\r\n        if CooldownKJ > 0 then\r\n            set CooldownKJ = CooldownKJ - CHECK_INTERVAL\r\n            return\r\n        endif\r\n        \r\n        // 3. Buscar enemigos cercanos\r\n        call GroupEnumUnitsInRange(TempGroup, x, y, KJ_AOE_RANGE, null)\r\n        \r\n        // Si hay enemigos, lanzar hechizo\r\n        if FirstOfGroup(TempGroup) != null then\r\n            // Efecto visual\r\n            call DestroyEffect(AddSpecialEffect(\"Abilities\\\\Spells\\\\Human\\\\FlameStrike\\\\FlameStrike1.mdl\", x, y))\r\n            call SetUnitAnimation(boss, \"spell\") \r\n            \r\n            loop\r\n                set target = FirstOfGroup(TempGroup)\r\n                exitwhen target == null\r\n                \r\n                // Solo enemigos vivos y no edificios\r\n                if IsUnitEnemy(target, GetOwningPlayer(boss)) and GetUnitState(target, UNIT_STATE_LIFE) > 0.405 and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then\r\n                    \r\n                    set angle = bj_RADTODEG * Atan2(GetUnitY(target) - y, GetUnitX(target) - x)\r\n                    \r\n                    // Empuje (PhysicsEngine)\r\n                    call PhysicsEngine_ApplyKnockback(target, angle, KJ_PUSH_DIST, 0.8, KJ_EFFECT)\r\n                    \r\n                    // Daño de fuego (CORREGIDO: Usamos 'null' en weapon type para evitar errores)\r\n                    call UnitDamageTarget(boss, target, 150.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE, null)\r\n                endif\r\n                \r\n                call GroupRemoveUnit(TempGroup, target)\r\n            endloop\r\n            \r\n            // Reiniciar Cooldown\r\n            set CooldownKJ = KJ_SPELL_COOLDOWN\r\n        endif\r\n        \r\n        call GroupClear(TempGroup)\r\n        set boss = null\r\n        set target = null\r\n    endfunction\r\n\r\n    // ================================================================\r\n    // HABILIDAD 2: ARTHAS - FROZEN GRIP (ATRACCIÓN)\r\n    // ================================================================\r\n    private function Arthas_Logic takes nothing returns nothing\r\n        local unit boss = udg_Game_Boss_Arthas\r\n        local unit target\r\n        local real x\r\n        local real y\r\n        \r\n        if boss == null or GetUnitState(boss, UNIT_STATE_LIFE) <= 0.405 then\r\n            return\r\n        endif\r\n        \r\n        set x = GetUnitX(boss)\r\n        set y = GetUnitY(boss)\r\n        \r\n        if CooldownLK > 0 then\r\n            set CooldownLK = CooldownLK - CHECK_INTERVAL\r\n            return\r\n        endif\r\n        \r\n        call GroupEnumUnitsInRange(TempGroup, x, y, LK_PULL_RANGE, null)\r\n        \r\n        if FirstOfGroup(TempGroup) != null then\r\n            call DestroyEffect(AddSpecialEffect(\"Abilities\\\\Spells\\\\Undead\\\\FreezingBreath\\\\FreezingBreathMissile.mdl\", x, y))\r\n            call SetUnitAnimation(boss, \"attack slam\") \r\n            \r\n            loop\r\n                set target = FirstOfGroup(TempGroup)\r\n                exitwhen target == null\r\n                \r\n                if IsUnitEnemy(target, GetOwningPlayer(boss)) and GetUnitState(target, UNIT_STATE_LIFE) > 0.405 and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then\r\n                    \r\n                    // Atracción (Vacuum)\r\n                    call PhysicsEngine_ApplyVacuum(target, x, y, 0.6)\r\n                    \r\n                    call DestroyEffect(AddSpecialEffectTarget(LK_EFFECT, target, \"origin\"))\r\n                    \r\n                    // Daño físico (Usamos 'null' aquí también por seguridad)\r\n                    call UnitDamageTarget(boss, target, 100.00, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, null)\r\n                endif\r\n                \r\n                call GroupRemoveUnit(TempGroup, target)\r\n            endloop\r\n            \r\n            set CooldownLK = LK_SPELL_COOLDOWN\r\n        endif\r\n        \r\n        call GroupClear(TempGroup)\r\n        set boss = null\r\n        set target = null\r\n    endfunction\r\n\r\n    // ================================================================\r\n    // INICIALIZACIÓN\r\n    // ================================================================\r\n    private function OnLoop takes nothing returns nothing\r\n        call Kiljaeden_Logic()\r\n        call Arthas_Logic()\r\n    endfunction\r\n\r\n    private function Init takes nothing returns nothing\r\n        call TimerStart(AiTimer, CHECK_INTERVAL, true, function OnLoop)\r\n    endfunction\r\n\r\nendlibrary",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}