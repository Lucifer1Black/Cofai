{
  "Id": 1760496784,
  "Comment": null,
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library DungeonEvent requires BossManager, ItemManager\r\n    /* ===========================================================================\r\n     * SISTEMA DE EVENTO DE MAZMORRA (DungeonEvent)\r\n     * -----------------------------------------------------------------------\r\n     * Autor: Arch-Architect\r\n     * Descripción: Maneja la secuencia: Spawn Boss -> Drop Gemas -> Spawn Héroes\r\n     * =========================================================================== */\r\n\r\n    globals\r\n        // [CONFIGURACIÓN] - ¡Cambia estos IDs por los de tu Object Editor (Ctrl+D)!\r\n        private constant integer BOSS_UNIT_ID     = 'n001' // El Boss inicial de la mazmorra\r\n        private constant integer GEM_ITEM_ID      = 'gem1' // ID del item \"Gema\"\r\n        private constant integer HERO_ARTHAS_ID   = 'Hart' // ID de la unidad Arthas\r\n        private constant integer HERO_KJ_ID       = 'Ukil' // ID de la unidad Kil'jaeden\r\n        \r\n        // Configuración de Drop\r\n        private constant integer GEM_COUNT        = 5      // Cuántas gemas suelta\r\n        private constant real    DROP_RADIUS      = 300.0  // Radio de dispersión de gemas\r\n        \r\n        // Variables internas\r\n        private trigger eventTrigger = null\r\n    endglobals\r\n\r\n    // ===========================================================================\r\n    //  LÓGICA INTERNA (Privada)\r\n    // ===========================================================================\r\n\r\n    // Esta función se ejecuta AUTOMÁTICAMENTE cuando el Boss muere\r\n    private function OnDungeonBossDeath takes nothing returns nothing\r\n        local unit dyingBoss = GetTriggerUnit()\r\n        local real x = GetUnitX(dyingBoss)\r\n        local real y = GetUnitY(dyingBoss)\r\n        local integer i = 0\r\n        local real angle\r\n        local real dropX\r\n        local real dropY\r\n        \r\n        call BJDebugMsg(\"|cffFF0000[EVENTO]|r ¡El Guardián ha caído! Los sellos se rompen...\")\r\n\r\n        // 1. Soltar Gemas (Esparcidas en círculo)\r\n        loop\r\n            exitwhen i >= GEM_COUNT\r\n            set angle = (360.0 / GEM_COUNT) * i * bj_DEGTORAD\r\n            set dropX = x + DROP_RADIUS * Cos(angle)\r\n            set dropY = y + DROP_RADIUS * Sin(angle)\r\n            \r\n            // Usamos CreateItem directamente para evitar leaks de Location\r\n            call CreateItem(GEM_ITEM_ID, dropX, dropY)\r\n            set i = i + 1\r\n        endloop\r\n\r\n        // 2. Spawnear a Arthas y Kil'jaeden\r\n        // Los creamos para el jugador Neutral Hostil (Player 11) o el que uses para enemigos\r\n        call CreateUnit(Player(11), HERO_ARTHAS_ID, x - 150, y - 150, 45.0)\r\n        call CreateUnit(Player(11), HERO_KJ_ID,     x + 150, y + 150, 225.0)\r\n        \r\n        // Efectos especiales para dar impacto visual (Opcional)\r\n        call DestroyEffect(AddSpecialEffect(\"Abilities\\\\Spells\\\\Human\\\\MassTeleport\\\\MassTeleportTarget.mdl\", x, y))\r\n\r\n        // Limpieza\r\n        call DestroyTrigger(eventTrigger) // Destruimos el trigger para liberar memoria\r\n        set eventTrigger = null\r\n        set dyingBoss = null\r\n    endfunction\r\n\r\n    // ===========================================================================\r\n    //  API PÚBLICA (Para usar en tus otros detonadores)\r\n    // ===========================================================================\r\n\r\n    /*\r\n     * Función: StartDungeon\r\n     * Uso: Call DungeonEvent_StartDungeon(x, y)\r\n     * Descripción: Inicia el encuentro creando al Boss y preparando su evento de muerte.\r\n     */\r\n    public function StartDungeon takes real x, real y returns nothing\r\n        local unit boss\r\n        \r\n        // 1. Crear al Boss usando el BossManager (si tiene lógica extra) o nativo\r\n        // Si BossManager tiene una función 'Create', úsala. Si no, usamos nativa:\r\n        set boss = CreateUnit(Player(11), BOSS_UNIT_ID, x, y, 270.0)\r\n        // REGISTRAR EN EL MANAGER\r\n        call BossManager_Register(boss)\r\n        \r\n        // 2. Registrar el evento de muerte ESPECÍFICO para esta unidad\r\n        // Esto es mucho más optimizado que un evento genérico \"A unit dies\"\r\n        set eventTrigger = CreateTrigger()\r\n        call TriggerRegisterUnitEvent(eventTrigger, boss, EVENT_UNIT_DEATH)\r\n        call TriggerAddAction(eventTrigger, function OnDungeonBossDeath)\r\n        \r\n        call BJDebugMsg(\"|cffFFFF00[EVENTO]|r ¡El Boss de la Mazmorra ha aparecido!\")\r\n        \r\n        set boss = null\r\n    endfunction\r\n\r\nendlibrary",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}