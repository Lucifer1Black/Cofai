{
  "Id": 50331829,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library BossClashSystem initializer Init requires BossAISystem\r\n\r\n    globals\r\n        // Declaramos las variables pero NO las asignamos todavía para evitar el error\r\n        private rect RECT_SPAWN_KJ = null\r\n        private rect RECT_SPAWN_LK = null\r\n    endglobals\r\n\r\n    function Trig_BOSS_Clash_Actions takes nothing returns nothing\r\n        local real xKJ\r\n        local real yKJ\r\n        local real xLK\r\n        local real yLK\r\n        \r\n        // 1. Limpieza de UI y Sonidos\r\n        if udg_Game_Boss_TW != null then\r\n            call DestroyTimerDialog(udg_Game_Boss_TW)\r\n        endif\r\n        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10.0, \"|cffffff00THE MASTERS HAVE BEEN SUMMONED.|r\")\r\n        \r\n        // Sonidos\r\n        if gg_snd_ShamanReady1 != null then\r\n            call StartSound(gg_snd_ShamanReady1)\r\n        endif\r\n        call PlayThematicMusic(\"war3mapImported\\\\Heroes of the Storm Haunted Mines.mp3\")\r\n        \r\n        // 2. PREPARAR COORDENADAS (Usando las variables que llenaremos en Init)\r\n        set xKJ = GetRectCenterX(RECT_SPAWN_KJ)\r\n        set yKJ = GetRectCenterY(RECT_SPAWN_KJ)\r\n        set xLK = GetRectCenterX(RECT_SPAWN_LK)\r\n        set yLK = GetRectCenterY(RECT_SPAWN_LK)\r\n        \r\n        // 3. REVIVIR A KIL'JAEDEN (LEGION)\r\n        call ShowUnit(udg_Game_Boss_Kiljaeden, true)\r\n        call ReviveHero(udg_Game_Boss_Kiljaeden, xKJ, yKJ, false)\r\n        \r\n        // Bonus de Gemas\r\n        call SetHeroStr(udg_Game_Boss_Kiljaeden, GetHeroStr(udg_Game_Boss_Kiljaeden, false) + udg_Game_Doubloons_Fire, true)\r\n        \r\n        // Efectos\r\n        call DestroyEffect(AddSpecialEffect(\"Abilities\\\\Spells\\\\Other\\\\Doom\\\\DoomDeath.mdl\", xKJ, yKJ))\r\n        call DestroyEffect(AddSpecialEffect(\"Objects\\\\Spawnmodels\\\\Other\\\\NeutralBuildingExplosion\\\\NeutralBuildingExplosion.mdl\", xKJ, yKJ))\r\n        call PingMinimap(xKJ, yKJ, 5.0) \r\n        \r\n        // 4. REVIVIR A ARTHAS (LICH KING)\r\n        call ShowUnit(udg_Game_Boss_Arthas, true)\r\n        call ReviveHero(udg_Game_Boss_Arthas, xLK, yLK, false)\r\n        \r\n        // Bonus de Gemas\r\n        call SetHeroStr(udg_Game_Boss_Arthas, GetHeroStr(udg_Game_Boss_Arthas, false) + udg_Game_Doubloons_Ice, true)\r\n        \r\n        // Efectos\r\n        call DestroyEffect(AddSpecialEffect(\"war3mapImported\\\\IceSparks.mdx\", xLK, yLK))\r\n        call PingMinimap(xLK, yLK, 5.0)\r\n        \r\n        // 5. RESETEAR GEMAS\r\n        set udg_Game_Doubloons_Fire = 0\r\n        set udg_Game_Doubloons_Ice = 0\r\n        \r\n        // 6. ORDENAR ATAQUE (Duelo a muerte)\r\n        call IssueTargetOrder(udg_Game_Boss_Kiljaeden, \"attack\", udg_Game_Boss_Arthas)\r\n        call IssueTargetOrder(udg_Game_Boss_Arthas, \"attack\", udg_Game_Boss_Kiljaeden)\r\n        \r\n        // 7. SISTEMAS\r\n        call DisableTrigger(gg_trg_Doubloon_Collect) \r\n        call EnableTrigger(gg_trg_BOSS_Health)       \r\n        \r\n        // 8. IA (Opcional)\r\n        if udg_AI_Turn_On then\r\n            set udg_AI_Ancient_Clash = true\r\n            set udg_AI_State_Push = false\r\n            if udg_AI_Push_Timer != null then\r\n                call PauseTimer(udg_AI_Push_Timer)\r\n            endif\r\n        endif\r\n        \r\n    endfunction\r\n\r\n    // ================================================================\r\n    // INICIALIZACIÓN\r\n    // ================================================================\r\n    private function Init takes nothing returns nothing\r\n        local trigger t = CreateTrigger()\r\n        \r\n        // === AQUÍ ASIGNAMOS LAS REGIONES ===\r\n        // Al hacerlo dentro de la función Init, nos aseguramos de que el mapa ya las creó.\r\n        set RECT_SPAWN_KJ = gg_rct_Creep01_MID_Melee\r\n        set RECT_SPAWN_LK = gg_rct_Creep02_MID_Melee\r\n        \r\n        call TriggerRegisterTimerExpireEvent(t, udg_Game_Boss)\r\n        call TriggerAddAction(t, function Trig_BOSS_Clash_Actions)\r\n    endfunction\r\n\r\nendlibrary",
  "Events": [
